# RITMO — configuración para Apache / Hostinger (se copia a dist/ al compilar)
AddType application/manifest+json .webmanifest
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  # El service worker, el HTML y el manifest deben revisarse siempre:
  # así las actualizaciones de la app no quedan trabadas en caché.
  <FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Los archivos con hash en el nombre no cambian nunca.
  <FilesMatch "^(index-.*|workbox-.*)\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
</IfModule>

# Forzar HTTPS (necesario para instalar la app y usar el service worker)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
